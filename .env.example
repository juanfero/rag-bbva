# Copiar a .env y completar. .env está en .gitignore: NUNCA versionar claves.

# --- Scraping ---
TARGET_BASE_URL=https://www.bbva.com.co/
# Límite de páginas a descargar
CRAWL_MAX_PAGES=300
# Profundidad máxima del recorrido BFS
CRAWL_MAX_DEPTH=3
# Pausa entre peticiones (cortesía con el sitio)
CRAWL_DELAY_SECONDS=1.0
CRAWL_USER_AGENT=RAG-BBVA-TechTest/1.0

# --- Chunking y embeddings ---
# Tamaño de chunk en caracteres; CHUNK_OVERLAP debe ser menor que CHUNK_SIZE
CHUNK_SIZE=800
CHUNK_OVERLAP=120
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- Base vectorial ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=bbva_docs

# --- Recuperación y reranking ---
# Candidatos recuperados de Qdrant
RETRIEVAL_TOP_K=20
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Chunks finales enviados al LLM (<= RETRIEVAL_TOP_K)
RERANK_TOP_N=5

# --- LLM (Grok de xAI vía API compatible con OpenAI) ---
# Proveedor: xai | fake (tests)
LLM_PROVIDER=xai
# Obligatoria con LLM_PROVIDER=xai. Secreta: solo en .env
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# Verificar en M7 con GET /v1/models
LLM_MODEL=grok-4.7
LLM_TEMPERATURE=0.1
# Tope de tokens de salida (controla costo)
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=60

# --- Historial y analítica ---
HISTORY_DB_PATH=data/history/history.db
# N mensajes previos usados como contexto (0 = sin memoria)
HISTORY_WINDOW_N=6
# Supuesto para estimar tiempo ahorrado por consulta resuelta
MANUAL_SEARCH_MINUTES=5

# --- Observabilidad ---
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
