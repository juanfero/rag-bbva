# Copiar a .env y completar. .env está en .gitignore: NUNCA versionar claves.

# --- Scraping ---
# Fuente de datos: Bancolombia (bbva.com.co bloquea crawlers, ver ADR-008)
TARGET_BASE_URL=https://www.bancolombia.com/
# Límite de páginas a descargar (1200 cubre el sitemap completo; en desarrollo: --max-pages 50)
CRAWL_MAX_PAGES=1200
# Profundidad máxima del BFS desde las semillas del sitemap
CRAWL_MAX_DEPTH=1
# Pausa entre peticiones (cortesía con el sitio)
CRAWL_DELAY_SECONDS=1.0
CRAWL_USER_AGENT=RAG-BBVA-TechTest/1.0
# Timeout por petición HTTP (segundos)
CRAWL_TIMEOUT_SECONDS=20
# Reintentos ante errores transitorios (5xx, timeouts) con backoff exponencial
CRAWL_MAX_RETRIES=3
# Espera base del backoff en segundos (2, 4, 8…)
CRAWL_BACKOFF_SECONDS=2.0
# Respuestas 403/429 consecutivas que abortan el crawl (posible bloqueo del WAF)
CRAWL_BLOCK_THRESHOLD=5
# Prefijos de ruta que no se piden (lista JSON). La sala de prensa redirige a otro host (ADR-010)
CRAWL_EXCLUDE_PATH_PREFIXES=["/acerca-de/sala-prensa/"]
# Carpeta de datos crudos (HTML + manifest.jsonl)
RAW_DATA_DIR=data/raw

# --- Limpieza ---
# Carpeta de documentos limpios (documents.jsonl + clean_report.json)
CLEAN_DATA_DIR=data/clean
# Documentos con menos caracteres de texto limpio se descartan (motivo: texto_corto)
CLEAN_MIN_CHARS=200
# trafilatura se usa si conserva al menos esta fracción del vocabulario del contenedor;
# si no, se usa el contenedor convertido a markdown por selector
CLEAN_MIN_EXTRACTION_COVERAGE=0.9

# --- Chunking y embeddings ---
# Tamaño de chunk en caracteres; CHUNK_OVERLAP debe ser menor que CHUNK_SIZE
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# Estrategia de chunking: heading_aware (títulos markdown + tamaño) | fixed_size (línea base)
CHUNKING_STRATEGY=heading_aware
# Chunks más cortos que esto se reportan como "muy cortos" en chunk_report.json
CHUNK_MIN_CHARS=100
# Carpeta de chunks.jsonl y chunk_report.json
CHUNKS_DATA_DIR=data/chunks
# Proveedor de embeddings: sentence_transformers | fake (tests, sin modelo)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_BATCH_SIZE=32
# Caché de modelos de Hugging Face (ignorada por git; volumen en M12)
MODEL_CACHE_DIR=models

# --- Base vectorial ---
# Qdrant del compose desde la máquina local; dentro de Docker (M12): http://qdrant:6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=bancolombia_docs
QDRANT_TIMEOUT_SECONDS=10
# Puntos por lote en cada upsert
QDRANT_BATCH_SIZE=128
# Caché de embeddings por hash del texto (ignorada por git): re-ingestar sin cambios no re-embebe
EMBEDDINGS_CACHE_DIR=data/embeddings

# --- Recuperación y reranking ---
# Candidatos recuperados de Qdrant
RETRIEVAL_TOP_K=20
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Chunks finales enviados al LLM (<= RETRIEVAL_TOP_K)
RERANK_TOP_N=5
# Máximo de chunks de una misma página en el top-n (0 = sin límite)
RERANK_MAX_CHUNKS_PER_DOC=2
# Score mínimo del reranker (#1) para responder; por debajo: "sin información suficiente".
# Calibrado con eval/calibration.jsonl (docs/modulos/M06.md). Es un logit, no un coseno.
RERANK_MIN_SCORE=1.6
RERANKER_MAX_LENGTH=512
RERANKER_BATCH_SIZE=16

# --- LLM (API compatible con OpenAI: Gemini por defecto, Grok como alternativa) ---
# Proveedor: gemini | xai | fake (tests)
LLM_PROVIDER=gemini
# Obligatoria con LLM_PROVIDER=gemini. Gratuita en https://aistudio.google.com/api-keys.
# Secreta: solo en .env. En el nivel gratuito Google puede usar las consultas para
# mejorar sus productos: no enviar información sensible (ver README).
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Obligatoria con LLM_PROVIDER=xai (de pago). Secreta: solo en .env
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# Verificar con `python -m rag_bbva.cli llm-check` (con xai: p. ej. grok-4.7)
LLM_MODEL=gemini-2.5-flash
# Solo Gemini: none apaga el razonamiento interno (menos latencia); low | medium | high
LLM_REASONING_EFFORT=none
LLM_TEMPERATURE=0.1
# Tope de tokens de salida (controla costo)
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=60
# Reintentos ante 429/5xx/timeouts (propios; el SDK no reintenta) y espera base del backoff
LLM_MAX_RETRIES=2
LLM_BACKOFF_SECONDS=1.0
# USD por millón de tokens (precio pago) para estimar el costo equivalente por consulta.
# gemini-2.5-flash: https://ai.google.dev/gemini-api/docs/pricing (con xai, grok-4.7: 2.0 / 6.0)
LLM_PRICE_INPUT_PER_MTOK=0.30
LLM_PRICE_OUTPUT_PER_MTOK=2.50
# Reformulación de la pregunta: off | history_only (solo con historial) | always
QUERY_REWRITE_MODE=history_only
QUERY_REWRITE_MAX_TOKENS=120

# --- Historial y analítica ---
HISTORY_DB_PATH=data/history/history.db
# N mensajes previos usados como contexto (0 = sin memoria)
HISTORY_WINDOW_N=6
# Supuesto para estimar tiempo ahorrado por consulta resuelta
MANUAL_SEARCH_MINUTES=5

# --- Observabilidad ---
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
